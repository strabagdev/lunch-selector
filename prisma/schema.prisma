generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum SelectionSource {
  PUBLIC_WEB
  ADMIN
  API
}

enum CalorieEstimateStatus {
  PENDING
  ESTIMATED
  FAILED
}

enum DailyReportDeliveryChannel {
  EMAIL
  WHATSAPP
}

enum DailyReportDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Person {
  id         String           @id @default(cuid())
  name       String
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  selections LunchSelection[]

  @@unique([name])
}

model MenuDay {
  id               String                @id @default(cuid())
  date             DateTime              @db.Date
  isClosed         Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  options          MenuOption[]
  selections       LunchSelection[]
  reportDeliveries DailyReportDelivery[]

  @@unique([date])
}

model MenuOption {
  id                    String                @id @default(cuid())
  menuDayId             String
  name                  String
  sortOrder             Int                   @default(0)
  isAvailable           Boolean               @default(true)
  caloriesKcal          Int?
  calorieEstimateStatus CalorieEstimateStatus @default(PENDING)
  calorieEstimatedAt    DateTime?
  calorieEstimateModel  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  menuDay               MenuDay               @relation(fields: [menuDayId], references: [id], onDelete: Cascade)
  selections            LunchSelection[]

  @@unique([id, menuDayId])
  @@unique([menuDayId, name])
  @@index([menuDayId, sortOrder])
}

model LunchSelection {
  id           String           @id @default(cuid())
  personId     String
  menuDayId    String
  menuOptionId String
  selectedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  source       SelectionSource?
  ipAddress    String?          @db.VarChar(45)
  userAgent    String?          @db.VarChar(512)
  sessionId    String?          @db.VarChar(36)
  person       Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  menuDay      MenuDay          @relation(fields: [menuDayId], references: [id], onDelete: Cascade)
  menuOption   MenuOption       @relation(fields: [menuOptionId, menuDayId], references: [id, menuDayId], onDelete: Cascade)

  @@unique([personId, menuDayId])
  @@index([menuDayId])
  @@index([menuOptionId])
  @@index([sessionId])
}

model DailyReportDelivery {
  id                 String                     @id @default(cuid())
  menuDayId          String
  channel            DailyReportDeliveryChannel
  recipientKey       String                     @db.VarChar(191)
  destination        String                     @db.Text
  status             DailyReportDeliveryStatus  @default(PENDING)
  attemptCount       Int                        @default(0)
  lastAttemptAt      DateTime?
  sentAt             DateTime?
  lastError          String?                    @db.Text
  leaseToken         String?                    @db.VarChar(36)
  leaseExpiresAt     DateTime?
  providerDeliveryId String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  menuDay            MenuDay                    @relation(fields: [menuDayId], references: [id], onDelete: Cascade)

  @@unique([menuDayId, channel, recipientKey])
  @@index([status, leaseExpiresAt])
  @@index([menuDayId])
}

model HomeMenuNarrative {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  text      String
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}
